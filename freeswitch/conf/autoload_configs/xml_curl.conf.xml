<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <!-- Replace SECRET in the gateway URLs. It must equal FS Switch Settings →
       XML-curl shared secret. The URL is rewritten by the container entrypoint
       or install-config.sh. -->
  <bindings>
    <binding name="directory">
      <param name="gateway-url" value="https://freeswitch.example.com/api/method/fs_switch.api.xml_curl?secret=SECRET" bindings="directory"/>
      <param name="method" value="POST"/>
      <param name="timeout" value="5"/>
    </binding>
    <binding name="configuration">
      <param name="gateway-url" value="https://freeswitch.example.com/api/method/fs_switch.api.xml_curl?secret=SECRET" bindings="configuration"/>
      <param name="method" value="POST"/>
      <param name="timeout" value="5"/>
    </binding>
    <binding name="dialplan">
      <param name="gateway-url" value="https://freeswitch.example.com/api/method/fs_switch.api.xml_curl?secret=SECRET" bindings="dialplan"/>
      <param name="method" value="POST"/>
      <param name="timeout" value="5"/>
    </binding>
  </bindings>
</configuration>
