# Copy to .env and change every CHANGE_ME value. Never commit .env.

# Frappe site
FS_SWITCH_SITE=fs-switch.localhost
FS_SWITCH_DB_ROOT_PASSWORD=CHANGE_ME
FS_SWITCH_ADMIN_PASSWORD=CHANGE_ME

# Shared by Frappe and FreeSWITCH for mod_xml_curl
FS_SWITCH_XML_CURL_SECRET=CHANGE_ME_LONG_RANDOM

# FreeSWITCH Event Socket Layer
FS_SWITCH_ESL_PASSWORD=CHANGE_ME

# Browser-facing WebRTC WebSocket. Use ws:// locally with the self-signed cert.
FS_SWITCH_WEBRTC_URL=ws://localhost:5066
FS_SWITCH_SIP_DOMAIN=localhost
FS_SWITCH_PUBLIC_IP=127.0.0.1

# Placeholder inbound number for local testing (no carrier in the box)
FS_SWITCH_MAIN_DID=1000
FS_SWITCH_DEFAULT_TENANT=default
FS_SWITCH_DEFAULT_CONTEXT=default

# Optional carrier gateway. Leave blank to run without a trunk.
# FS_SWITCH_TRUNK_PROXY=sip.example.com:5060
# FS_SWITCH_TRUNK_USERNAME=
# FS_SWITCH_TRUNK_PASSWORD=
# FS_SWITCH_TRUNK_REALM=sip.example.com
